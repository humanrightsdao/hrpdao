# Foundry build artifacts (regenerated by `forge build`)
out/
cache/
cache_forge/

# Environment variables - protect secrets (RPC URLs, Etherscan/Arbiscan keys,
# and — critically — any PRIVATE_KEY / MNEMONIC used for deployment)
.env
.env.local
.env.*.local
!.env.example

# Broadcast logs contain only public tx data (addresses, calldata, tx hashes) —
# safe to keep for on-chain transparency. Uncomment below if you'd rather not
# publish deployment history:
# broadcast/

# OS-specific files
.DS_Store
Thumbs.db

# Editor and IDE files
.vscode/*
!.vscode/extensions.json
.idea/
.zed/

# Temporary and backup files
*.tmp
*.bak
*.swp
*~

# Foundry lockfile is fine to commit; keeping it explicit here as a reminder.
# foundry.lock
