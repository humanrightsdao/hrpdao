.ipynb_checkpoints/
.venv/
venv/

# ==============================
# ZK / circom build & proving artifacts
# ==============================
# Trusted-setup / powers-of-tau files are large and publicly downloadable — don't commit them.
*.ptau
# Intermediate circuit-compilation output (regeneratable from the .circom source).
zk/build/*.r1cs
zk/build/*_js/
zk/build/witness_calculator.js
# One-off local proof/witness artifacts from testing the flow — regeneratable, often contain
# the exact private inputs used for a local test run.
witness.wtns
*.wtns
proof.json
public.json
input.json
calldata.txt
build_input.js.log
# NOTE: final .zkey / verification_key*.json are usually needed by consumers of the circuit
# to generate or verify proofs — think before ignoring these; if you keep them, consider
# Git LFS since they can be several MB+.

# ==============================
# Security scan output (regeneratable audit artifacts)
# ==============================
slither_raw.json
*.slither.json

