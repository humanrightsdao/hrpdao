# ============================================================
# UNIFIED .gitignore — dao / contracts / dossier / atticus
# Works at any nesting depth, so it's safe to drop this at the
# root of a monorepo containing all four project folders.
# ============================================================

# ==============================
# Environment variables / secrets
# ==============================
.env
.env.*
!.env.example
!.env.*.example
env
env.*
!env.example
!env.*.example
*.env
*.env.*
.envrc
server/.env
server/.env.*
!server/.env.example
secrets.json
secrets.*.json
secret.*
credentials.*
config.local.*
*.local.json
*.local.yaml
*.local.yml
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*credentials*
*api-key*
*apikey*
*.keystore
walletconnect.json
mnemonic.txt
seed.txt
seedphrase*
private-key*
deployer-key*
*.secret

# ==============================
# Dependencies
# ==============================
node_modules/
jspm_packages/
bower_components/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ==============================
# Build outputs
# ==============================
dist/
dist-ssr/
build/
out/
.output/
/.next/
.nuxt/
.svelte-kit/
server/dist/
server/build/
*.local
*.tsbuildinfo

# ==============================
# Logs and debug files
# ==============================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================
# Linter / test cache
# ==============================
.eslintcache
.stylelintcache
coverage/
.nyc_output/
.cache/
.parcel-cache/
.turbo/
.vite/
.rollup.cache/

# ==============================
# Foundry / Solidity (contracts)
# ==============================
cache/
broadcast/*/31337/
broadcast/*/dry-run/
# Uncomment to drop ALL deployment history instead of just local/anvil noise:
# broadcast/

# ==============================
# Hardhat (in case it's ever mixed in)
# ==============================
artifacts/
typechain/
typechain-types/

# ==============================
# ZK / circom build & proving artifacts (contracts/zk)
# ==============================
*.ptau
zk/build/*.r1cs
zk/build/*_js/
zk/build/witness_calculator.js
witness.wtns
*.wtns
proof.json
public.json
input.json
calldata.txt
# NOTE: final *.zkey / verification_key*.json are usually needed to generate
# or verify proofs — think before ignoring; consider Git LFS if you keep them.

# ==============================
# Security scan output (regeneratable audit artifacts)
# ==============================
slither_raw.json
*.slither.json

# ==============================
# Python (Slither, scripts, etc.)
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.tox/
.ipynb_checkpoints/
.venv/
venv/

# ==============================
# Deployment / hosting platforms
# ==============================
.vercel
.netlify
.wrangler/
.cloudflare/
.firebase/
.serverless/
.now/

# ==============================
# Supabase local CLI (cache/logs only — keep migrations tracked)
# ==============================
.supabase/

# ==============================
# Databases (local)
# ==============================
*.sqlite
*.sqlite3
*.db

# ==============================
# Docker
# ==============================
docker-compose.override.yml

# ==============================
# Runtime / process files
# ==============================
*.pid
*.seed
*.pid.lock
pids/

# ==============================
# OS-specific files
# ==============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ==============================
# Editor and IDE files
# ==============================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project
*.iml

# ==============================
# Temporary and backup files
# ==============================
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
tmp/
temp/

# ==============================
# Archives (don't commit source dumps you drag in locally)
# ==============================
*.rar
*.zip
*.7z
*.tar
*.tar.gz

# ==============================
# Misc
# ==============================
.history/
