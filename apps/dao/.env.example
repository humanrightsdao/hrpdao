# ── CAPTCHA (Cloudflare Turnstile) ────────────────────────────────
# Ported from dossier: src/components/CaptchaGate.jsx reads this at
# build time to render the widget, and worker/index.js's
# handleVerifyCaptcha verifies the resulting token server-side against
# the Turnstile API using the TURNSTILE_SECRET_KEY secret (NOT set
# here — add it with `npx wrangler secret put TURNSTILE_SECRET_KEY`,
# same as GEMINI_API_KEY).
# ⚠️ Must be prefixed with VITE_ — the client reads
# import.meta.env.VITE_TURNSTILE_SITE_KEY, an unprefixed
# TURNSTILE_SITE_KEY is invisible to Vite's client bundle (see
# dossier/.env for the same fix there).
# This is a *site* key, safe to be public — create your own widget for
# dao's hostname at https://dash.cloudflare.com → Turnstile (don't
# reuse dossier's site key, Turnstile site keys are scoped to specific
# hostnames).
VITE_TURNSTILE_SITE_KEY=

# ── Embedded wallet (Privy) — MUST match dossier's .env.local ─────
# This is what makes login "synchronous" across apps: Privy derives a
# user's embedded wallet address from (App ID + login identity), not
# from anything stored in this browser. Same App ID + same email/
# Google/passkey in both apps = the exact same wallet address, so
# RIGHTS/Shield/Council membership shows up in both automatically.
# Reused directly from dossier/.env here — change in BOTH places if
# you ever rotate it.
VITE_PRIVY_APP_ID=
VITE_WALLETCONNECT_PROJECT_ID=

# ── Chain ──────────────────────────────────────────────────────────
VITE_USE_LOCAL_CHAIN=
VITE_ARBITRUM_SEPOLIA_RPC=
# Block the DaoGovernor/DisciplineModule were deployed at — lets
# loadProposals()/loadSanctionProposals() scan logs from genesis
# instead of a fixed lookback window. Fill in after deployment.
VITE_DAO_GOVERNOR_DEPLOY_BLOCK=

# ── Contracts (Arbitrum Sepolia, hrpdaolenstoken_arbitrum_influence)
# ⚠️ Must be the SAME addresses as dossier's .env.local — copy/paste
# both ways after deploying, they read the exact same env var names.
VITE_RIGHTS_REGISTRY=
# ── Dossier's Lens app address ──────────────────────────────────────
# Same value as dossier-app's own VITE_LENS_APP_ADDRESS. Needed by
# src/lib/dossierRead.js (HomePage's read-only world map + feed) to
# filter Lens posts down to "posts published through the Dossier app"
# and to scope fetchAllModActions()'s scan the same way dossier itself
# does — otherwise the moderation-action tally would include every
# app's posts on the shared Lens testnet, not just Dossier's.
VITE_LENS_APP_ADDRESS=
VITE_SHIELD_SBT=
VITE_COUNCIL_SBT=
VITE_DAO_TIMELOCK=
VITE_DAO_GOVERNOR=
VITE_DISCIPLINE_MODULE=
VITE_TIP_JAR=
VITE_HUMANITY_GATE=
VITE_MOCK_PASSPORT_DECODER=
VITE_PASSPORT_ADAPTER=
# ^ Not deployed in the latest run (деплой_Інфлюенс.txt) — that
# deploy used HumanityGate + MockHumanityProvider directly, not
# the separate PassportAdapter/OptimisticEpochSubmission path.
# Leave blank unless/until those get their own deployment.
VITE_LOCATION_REGISTRY=
VITE_COUNCIL_RANKING_EPOCH=
VITE_OPTIMISTIC_EPOCH_SUBMISSION=
VITE_TREASURY=
VITE_TEST_TOKEN_USD=

# ── Link to the linked Dossier app ─────────────────────────────────
# Now also consumed by THIS app's own Layout.jsx (single "Dossier"
# link replacing the old separate "DAO Chronicle I/II" links) — in
# addition to its original use by Dossier's own GovernanceRedirect.jsx
# / ModerationQueue.jsx to link back here.
VITE_DOSSIER_APP_URL=
