TURNSTILE_SITE_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_WALLETCONNECT_PROJECT_ID=
# Отримати на https://dashboard.privy.io — окремий App ID для embedded-гаманця
VITE_PRIVY_APP_ID=
VITE_LENS_APP_ADDRESS=
# ⚠️ MIGRATED to Arbitrum Sepolia (421614) — see hooks/useLensDAO.js header.
# The addresses below used to point at the OLD DAO deployment on Lens
# Chain Sepolia (37111). They must now be the SAME addresses as the
# separate dao-app's .env.local (new contracts, redeployed from the
# hrpdaolenstoken_arbitrum_influence archive). Fill them in after
# deploying/copying from dao-app — until then the app falls back to
# harmless placeholder addresses (0x0000...0001, ...0002, etc.) and
# every on-chain DAO read/write will simply fail gracefully.
VITE_USE_LOCAL_CHAIN=
VITE_ARBITRUM_SEPOLIA_RPC=
# Block the DaoGovernor/DisciplineModule were deployed at — lets
# loadProposals()/loadSanctionProposals() scan logs from genesis
# instead of a fixed lookback window. Fill in after deployment.
VITE_DAO_GOVERNOR_DEPLOY_BLOCK=

# ── Rights / Defender status / Consul status ─────────────────────
VITE_RIGHTS_REGISTRY=
VITE_SHIELD_SBT=
VITE_COUNCIL_SBT=

# ── Governance (DaoGovernor + DaoTimelock, without Senate) ───────
VITE_DAO_TIMELOCK=
VITE_DAO_GOVERNOR=

# ── Membership / discipline / rewards ────────────────────────────
VITE_DISCIPLINE_MODULE=
VITE_TIP_JAR=

# ── Humanity verification ─────────────────────────────────────────
VITE_HUMANITY_GATE=
VITE_MOCK_PASSPORT_DECODER=
VITE_PASSPORT_ADAPTER=

# ── Geo module (H3 hexagons, cascading ranking model) ─────────────
VITE_LOCATION_REGISTRY=
VITE_COUNCIL_RANKING_EPOCH=
VITE_OPTIMISTIC_EPOCH_SUBMISSION=

# ── Treasury ───────────────────────────────────────────────────────
VITE_TREASURY=

# ── Testnet mocks ──────────────────────────────────────────────────
VITE_TEST_TOKEN_USD=

# ── Link out to the separate DAO management app (full governance:
# token/proposals/propose/params) — used by GovernanceRedirect.jsx
# and the "Full DAO governance ↗" banner on the Moderation page.
VITE_DAO_APP_URL=
