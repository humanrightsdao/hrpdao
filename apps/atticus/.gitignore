# Logs
*.log
npm-debug.log*

# Dependencies
node_modules/

# Environment variables - protect secrets (GEMINI_API_KEY, PORT, etc.)
.env
.env.local
.env.*.local

# Allow committing an example/template file (without real secrets)
!.env.example

# OS-specific files
.DS_Store
Thumbs.db

# Editor and IDE files
.vscode/*
!.vscode/extensions.json
.idea/
.zed/

# Temporary and backup files
*.tmp
*.bak
*.swp
*~

# Build output (if a bundler is added later)
dist/
build/
